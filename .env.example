# Rutas de juegos del panel de gestión (sin barra final).
# Local: http://localhost:3000/api/games
DASHBOARD_GAMES_URL=
# Igual a GAMES_WEBHOOK_SECRET en el panel.
DASHBOARD_GAMES_SECRET=

# Opcional: Sentry. Sin DSN, Sentry no hace nada.
# PUBLIC_SENTRY_DSN se lee al compilar (navegador); SENTRY_DSN, al ejecutar (servidor).
# PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Subida de source maps en el build. Sin token, el build no sube nada y no falla.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
